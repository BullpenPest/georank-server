# --- Server ---------------------------------------------------------------
PORT=4000
# Public base URL of this server once deployed (e.g. https://xxx.onrender.com).
# Used to build the public media URLs that GBP/Meta fetch when publishing.
PUBLIC_BASE_URL=

# --- Google Business Profile (OAuth2) ---------------------------------------
# Create these in Google Cloud Console → APIs & Services → Credentials
# (OAuth client ID, type "Web application"). See server/README.md for the
# full setup flow, required scopes, and API-approval notes.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# Long-lived refresh token obtained via the one-time OAuth consent flow.
GBP_REFRESH_TOKEN=
# Numeric IDs of the GBP account + location to publish to.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# --- Facebook / Instagram (Meta Graph API) ----------------------------------
# Page access token with pages_manage_posts + pages_read_engagement.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Instagram professional account linked to the Facebook Page.
IG_USER_ID=
# Usually the same as the page token for linked accounts.
IG_ACCESS_TOKEN=
